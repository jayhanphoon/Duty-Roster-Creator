      getStationNames().forEach(s=>{ss.innerHTML+='<option value="'+escHtml(s)+'"'+(s===pv?' selected':'')+'>'+escHtml(s)+'</option>';});
      const ps=document.getElementById('subPrefect'); const pp=ps.value;
