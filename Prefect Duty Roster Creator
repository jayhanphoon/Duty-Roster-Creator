    // ================================================================
    //  GENERATION
    // ================================================================
    function handleGenerate() {
      const prefects = getPrefectNames();
      const stationNames = getStationNames();
      const breakCaps = stations.map(s=>Math.max(1,parseInt(s.breakCap)||1));
      const lunchCaps = stations.map(s=>Math.max(1,parseInt(s.lunchCap)||1));

      if(prefects.length<2){showAlert('Add at least 2 prefect names.','error');return;}
      if(stationNames.length<1){showAlert('Add at least 1 station.','error');return;}

      const bTotal = breakCaps.reduce((a,b)=>a+b,0);
      const lTotal = lunchCaps.reduce((a,b)=>a+b,0);
      if(bTotal!==prefects.length){showAlert('Break total ('+bTotal+') must equal prefects ('+prefects.length+').','error');return;}
      if(lTotal!==prefects.length){showAlert('Lunch total ('+lTotal+') must equal prefects ('+prefects.length+').','error');return;}

      const cleanUnavail = unavailable.filter(u=>u.prefect&&u.day&&u.shift);
      const cleanBanned = banned.filter(b=>b.prefect&&b.station);
      const cleanAvoid = avoidPairs.filter(a=>a.a&&a.b&&a.a!==a.b);
      const cleanBuddies = buddies.filter(b=>b.a&&b.b&&b.a!==b.b);

      const seenA=new Set(); const uniqueAvoid=[]; cleanAvoid.forEach(ap=>{const k=[ap.a,ap.b].sort().join('::');if(!seenA.has(k)){seenA.add(k);uniqueAvoid.push(ap);}});
      const seenB=new Set(); const uniqueBuddies=[]; cleanBuddies.forEach(b=>{const k=[b.a,b.b].sort().join('::');if(!seenB.has(k)){seenB.add(k);uniqueBuddies.push(b);}});

      showGenerating(true);
      setTimeout(()=>{
        const result = generateRoster(prefects,stationNames,breakCaps,lunchCaps,cleanUnavail,uniqueBuddies,uniqueAvoid,cleanBanned);
        showGenerating(false);
        if(result.error){showAlert(result.error,'error');return;}
        cachedRoster=result.roster; cachedStats=result.stats;
        renderRoster(result.roster,stationNames,prefects);
        renderStats(result.stats,prefects);
        renderFairnessAnalytics(result.roster,stationNames,prefects);
        renderAlerts(result.warnings);
        populateSubFinderDropdowns();
      },80);
    }

    function showGenerating(active) {
      document.getElementById('generateBtn').disabled=active;
      document.getElementById('generateBtnText').innerHTML=active?'<span class="load-spinner"></span> Generating…':'<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg> Generate Roster';
    }

    // ================================================================
    //  CORE ALGORITHM
    // ================================================================
    function generateRoster(prefects,stationNames,breakCaps,lunchCaps,unavailableData,buddies,avoidPairs,bannedStations) {
      const N=prefects.length;
      if(breakCaps.reduce((a,b)=>a+b,0)!==N) return {error:'Break capacity mismatch'};
      if(lunchCaps.reduce((a,b)=>a+b,0)!==N) return {error:'Lunch capacity mismatch'};

      const bannedSet=new Set(bannedStations.map(b=>b.prefect+'::'+b.station));
      const unavailableSet=new Set(unavailableData.map(u=>u.prefect+'::'+u.day+'::'+u.shift));
      const avoidMap={};
      avoidPairs.forEach(ap=>{
        if(!avoidMap[ap.a]) avoidMap[ap.a]=new Set();
        if(!avoidMap[ap.b]) avoidMap[ap.b]=new Set();
        avoidMap[ap.a].add(ap.b); avoidMap[ap.b].add(ap.a);
      });

      const buddyAttemptMap={};
      buddies.forEach(b=>{
        const num=1+Math.floor(Math.random()*2);
        const combos=[];
        DAYS.forEach(d=>SHIFTS.forEach(s=>combos.push({day:d,shift:s})));
        shuffleArray(combos);
        for(let i=0;i<Math.min(num,combos.length);i++){
          const k=combos[i].day+'::'+combos[i].shift;
          if(!buddyAttemptMap[k]) buddyAttemptMap[k]=[];
          buddyAttemptMap[k].push(b);
        }
      });

      const shiftCount={}; prefects.forEach(p=>shiftCount[p]=0);
      const yesterdayStation={}; prefects.forEach(p=>yesterdayStation[p]={Break:null,Lunch:null});

      const roster={};
      const warnings=[];

      DAYS.forEach((day,dayIdx)=>{
        roster[day]={};
        SHIFTS.forEach(shift=>{
          const caps = shift==='Break'?breakCaps:lunchCaps;
          roster[day][shift]={};
          stationNames.forEach(s=>roster[day][shift][s]=[]);

          const prevDayStation={};
          prefects.forEach(p=>prevDayStation[p]=yesterdayStation[p][shift]);

          const available = prefects.filter(p=>!unavailableSet.has(p+'::'+day+'::'+shift));
          const assignedToday = new Set();
          const buddyToday = buddyAttemptMap[day+'::'+shift]||[];

          buddyToday.forEach(b=>{
            if(assignedToday.has(b.a)||assignedToday.has(b.b)) return;
            if(!available.includes(b.a)||!available.includes(b.b)) return;
            for(const station of shuffleArray([...stationNames])){
              const cur = roster[day][shift][station].length;
              const cap = caps[stationNames.indexOf(station)];
              if(cur+2>cap) continue;
              if(bannedSet.has(b.a+'::'+station)||bannedSet.has(b.b+'::'+station)) continue;
              let bad=false;
              for(const p of [b.a,b.b]){
                if(avoidMap[p]) for(const ex of roster[day][shift][station]) if(avoidMap[p].has(ex)){bad=true;break;}
                if(bad) break;
              }
              if(bad) continue;
              roster[day][shift][station].push(b.a,b.b);
              assignedToday.add(b.a); assignedToday.add(b.b);
              shiftCount[b.a]++; shiftCount[b.b]++;
              yesterdayStation[b.a][shift]=station; yesterdayStation[b.b][shift]=station;
              break;
            }
          });

          for(const station of shuffleArray([...stationNames])){
            const needed = caps[stationNames.indexOf(station)] - roster[day][shift][station].length;
            if(needed<=0) continue;

            const candidates = prefects.filter(p=>{
              if(assignedToday.has(p)) return false;
              if(unavailableSet.has(p+'::'+day+'::'+shift)) return false;
              if(bannedSet.has(p+'::'+station)) return false;
              return true;
            });

            if(candidates.length<needed) warnings.push('Short of prefects for '+station+' on '+day+' '+shift+' (need '+needed+', have '+candidates.length+')');

            const scored = candidates.map(p=>({
              prefect:p,
              score:scorePrefect(p,station,shiftCount,prevDayStation,roster[day][shift],avoidMap,buddies)
            }));
            scored.sort((a,b)=>b.score-a.score);

            const toFill=Math.min(needed,scored.length);
            const selected=[];
            for(let s=0;s<scored.length&&selected.length<toFill;s++){
              const p=scored[s].prefect;
              let conflict=false;
              if(avoidMap[p]){
                for(const other of [...roster[day][shift][station],...selected])
                  if(avoidMap[p].has(other)){conflict=true;break;}
              }
              if(!conflict) selected.push(p);
            }

            selected.forEach(p=>{
              roster[day][shift][station].push(p);
              assignedToday.add(p);
              shiftCount[p]++;
              yesterdayStation[p][shift]=station;
            });
            if(selected.length<needed) warnings.push('Could only fill '+selected.length+'/'+needed+' for '+station+' on '+day+' '+shift);
          }

          const unassigned = available.filter(p=>!assignedToday.has(p));
          if(unassigned.length>0){
            warnings.push(unassigned.length+' prefect(s) unassigned on '+day+' '+shift);
            for(const p of unassigned){
              for(const station of stationNames){
                if(bannedSet.has(p+'::'+station)) continue;
                if(roster[day][shift][station].length<caps[stationNames.indexOf(station)]){
                  roster[day][shift][station].push(p);
                  assignedToday.add(p);
                  shiftCount[p]++;
                  yesterdayStation[p][shift]=station;
                  break;
                }
              }
            }
          }
        });
      });

      const counts=prefects.map(p=>shiftCount[p]||0);
      const stats={shiftCount,totalSlots:N*DAYS.length*2,avgShifts:(N*DAYS.length*2)/N,maxShifts:Math.max(...counts),minShifts:Math.min(...counts),range:Math.max(...counts)-Math.min(...counts),warnings};
      return {roster,stats,warnings};
    }

    function scorePrefect(prefect,station,shiftCount,prevDayStation,dayRoster,avoidMap,buddyPairs) {
      let score=0;
      score-=(shiftCount[prefect]||0)*10;
      if(prevDayStation[prefect]===station) score-=50;
      if(avoidMap[prefect]){
        const atThisStation = dayRoster[station]||[];
        for(const other of atThisStation){
          if(avoidMap[prefect].has(other)){score-=100;break;}
        }
      }
      if(buddyPairs){
        const atThisStation = dayRoster[station]||[];
        buddyPairs.forEach(b=>{
          const partner = b.a===prefect?b.b:(b.b===prefect?b.a:null);
          if(partner&&atThisStation.includes(partner)) score+=30;
        });
      }
      score+=Math.random()*5;
      return score;
    }

