<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Prefectural Board Duty Roster</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <style>
    :root {
      --break: #34d399;
      --lunch: #22d3ee;
      --accent: #6366f1;
    }
    * { font-family: 'DM Sans', system-ui, sans-serif; }
    h1, h2, h3, h4, h5, h6, .heading { font-family: 'Sora', system-ui, sans-serif; }
    body {
      background: #0f172a;
      background-image:
        radial-gradient(ellipse at 20% 50%, rgba(99,102,241,0.04) 0%, transparent 50%),
        radial-gradient(ellipse at 80% 20%, rgba(52,211,153,0.03) 0%, transparent 50%),
        radial-gradient(ellipse at 60% 80%, rgba(34,211,238,0.03) 0%, transparent 50%);
    }
    .glass {
      background: rgba(30,41,59,0.55);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(51,65,85,0.5);
    }
    .glass-strong {
      background: rgba(30,41,59,0.7);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(51,65,85,0.6);
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      padding: 0.25rem 0.625rem;
      border-radius: 0.5rem;
      font-size: 0.75rem;
      font-weight: 500;
      background: rgba(51,65,85,0.5);
      color: #e2e8f0;
      border: 1px solid rgba(71,85,105,0.4);
      transition: all 0.15s ease;
    }
    .badge:hover {
      background: rgba(51,65,85,0.8);
      transform: translateY(-1px);
    }
    .badge-dot {
      width: 0.375rem;
      height: 0.375rem;
      border-radius: 50%;
      flex-shrink: 0;
    }
    .fade-in { animation: fadeUp 0.35s ease-out both; }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .scale-hover { transition: all 0.2s ease; }
    .scale-hover:hover { transform: scale(1.02); }
    .scale-hover:active { transform: scale(0.98); }
    .roster-table th, .roster-table td { border-color: rgba(51,65,85,0.6); }
    .roster-table tbody tr { transition: background 0.15s ease; }
    .roster-table tbody tr:hover { background: rgba(51,65,85,0.2); }
    select option { background: #1e293b; color: #e2e8f0; }
    input[type="number"]::-webkit-inner-spin-button { opacity: 0.5; }
    details summary::-webkit-details-marker { display: none; }
    details summary { list-style: none; }
    .glow-indigo { box-shadow: 0 0 20px rgba(99,102,241,0.15); }
    .glow-emerald { box-shadow: 0 0 20px rgba(52,211,153,0.1); }
    .glow-cyan { box-shadow: 0 0 20px rgba(34,211,238,0.1); }
    .load-spinner {
      display: inline-block;
      width: 1rem;
      height: 1rem;
      border: 2px solid rgba(255,255,255,0.3);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
      vertical-align: middle;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .fair-table th, .fair-table td { border-color: rgba(51,65,85,0.6); }
    .fair-table tbody tr { transition: background 0.15s ease; }
    .fair-table tbody tr:hover { background: rgba(51,65,85,0.2); }
    .badge-perfect { background: rgba(52,211,153,0.12); color: #34d399; border: 1px solid rgba(52,211,153,0.25); }
    .badge-warning { background: rgba(251,191,36,0.12); color: #fbbf24; border: 1px solid rgba(251,191,36,0.25); }

    @media print {
      @page { size: landscape; margin: 0.5in; }
      body {
        background: #fff !important;
        background-image: none !important;
      }
      header,
      section.xl\:col-span-4,
      #alertsContainer,
      #statsContainer,
      #substituteFinder,
      #fairnessContainer,
      footer {
        display: none !important;
      }
      .xl\:col-span-8 {
        max-width: 100% !important;
        flex: 0 0 100% !important;
        grid-column: 1 / -1 !important;
      }
      .grid { display: block !important; }
      .glass, .glass-strong {
        background: #fff !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
        border: 1px solid #ccc !important;
        box-shadow: none !important;
      }
      .roster-table th, .roster-table td {
        border-color: #999 !important;
        color: #222 !important;
      }
      .roster-table thead tr { background: #eee !important; }
      .roster-table tbody tr { border-color: #ccc !important; }
      .roster-table tbody tr:hover { background: transparent !important; }
      .badge {
        background: #f4f4f4 !important;
        color: #222 !important;
        border: 1px solid #bbb !important;
        print-color-adjust: exact;
        -webkit-print-color-adjust: exact;
      }
      .badge-dot { filter: saturate(0.6); }
      h1, h2, h3, .heading, .text-slate-200, .text-slate-300, .text-slate-400, .text-sm {
        color: #222 !important;
      }
      .text-slate-500, .text-slate-600, #rosterMeta { color: #555 !important; }
      .text-emerald-400 { color: #166534 !important; }
      .text-cyan-400 { color: #0e7490 !important; }
      .bg-emerald-500\/\[0\.02\],
      .bg-cyan-500\/\[0\.02\] { background: #fafafa !important; }
      .bg-emerald-500\/10 { background: #ecfdf5 !important; }
      .bg-cyan-500\/10 { background: #ecfeff !important; }
      .border-slate-700\/40, .border-slate-700\/30, .border-slate-700\/60 { border-color: #ccc !important; }
      .text-indigo-400 { color: #4338ca !important; }
      #rosterContainer { overflow: visible !important; padding: 0 !important; }
      main { padding-top: 0 !important; }
      .xl\:col-span-8 > .glass-strong { border: none !important; }
    }
  </style>
</head>
<body>

  <!-- ========== HEADER ========== -->
  <header class="relative border-b border-slate-700/40 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-r from-slate-900 via-indigo-950/60 to-slate-900 pointer-events-none"></div>
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-indigo-500/5 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-7">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-4 min-w-0">
          <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-600 shadow-lg shadow-indigo-500/25 shrink-0">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
          </div>
          <div>
            <h1 class="text-xl sm:text-2xl font-bold text-white heading tracking-tight">Duty Roster</h1>
            <p class="text-sm text-slate-400/90 mt-0.5">Assign every prefect to a <span class="text-emerald-400 font-medium">Break</span> and a <span class="text-cyan-400 font-medium">Lunch</span> station each day</p>
          </div>
        </div>
        <button onclick="window.print()" class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 text-sm font-medium rounded-xl bg-white/5 text-slate-300 hover:bg-white/10 hover:text-white border border-slate-600/50 transition-all duration-200 scale-hover shrink-0 focus:ring-2 focus:ring-indigo-500/30 focus:outline-none">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          Print Roster
        </button>
      </div>
    </div>
  </header>

  <!-- ========== MAIN ========== -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <div class="grid grid-cols-1 xl:grid-cols-12 gap-6">

      <!-- ===== LEFT — CONFIG ===== -->
      <section class="xl:col-span-4 space-y-4">

        <!-- Prefect Names -->
        <div class="glass rounded-2xl p-5 fade-in">
          <label class="flex items-center gap-2 text-sm font-semibold text-slate-300 heading mb-2.5">
            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Prefect Names
          </label>
          <textarea id="prefectsInput" rows="4" placeholder="One name per line&#10;e.g.&#10;John Smith&#10;Sarah Johnson"
            class="w-full bg-slate-800/80 border border-slate-700/60 rounded-xl px-3.5 py-2.5 text-sm text-slate-200 placeholder:text-slate-500 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none resize-y transition-all duration-200"
            oninput="refreshAllDropdowns(); autoSave()"></textarea>
        </div>

        <!-- Station Capacities -->
        <div class="glass rounded-2xl p-5 fade-in" style="animation-delay:0.05s">
          <div class="flex items-center justify-between mb-3">
            <label class="flex items-center gap-2 text-sm font-semibold text-slate-300 heading">
              <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Station Capacities
            </label>
            <button onclick="addStation()" class="text-xs font-medium text-indigo-400 hover:text-indigo-300 px-2.5 py-1.5 rounded-lg hover:bg-indigo-500/10 transition-all duration-200">+ Add Station</button>
          </div>
          <div class="grid grid-cols-12 gap-1.5 mb-2 text-[10px] font-medium text-slate-500 uppercase tracking-widest px-1">
            <div class="col-span-5">Station</div>
            <div class="col-span-3 text-center">
              <span class="text-emerald-400/70">Break</span>
            </div>
            <div class="col-span-3 text-center">
              <span class="text-cyan-400/70">Lunch</span>
            </div>
            <div class="col-span-1"></div>
          </div>
          <div id="stationsContainer" class="space-y-1.5"></div>
          <div id="stationValidation" class="mt-2.5 space-y-1 text-xs"></div>
        </div>

        <!-- Constraints -->
        <div class="glass rounded-2xl p-5 fade-in" style="animation-delay:0.1s">
          <div class="flex items-center gap-2 text-sm font-semibold text-slate-300 heading mb-1">
            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
            Constraints
          </div>

          <!-- Unavailable -->
          <details class="group mt-2">
            <summary class="flex items-center justify-between cursor-pointer text-xs font-medium text-slate-500 uppercase tracking-wider py-2 px-1 rounded-lg hover:bg-slate-700/20 transition-colors">
              <span>Unavailable</span>
              <span class="flex items-center gap-2">
                <button onclick="event.stopPropagation(); addUnavailable()" class="text-indigo-400 hover:text-indigo-300 font-normal normal-case text-xs px-2 py-0.5 rounded hover:bg-indigo-500/10 transition-colors">+ Add</button>
                <svg class="w-3.5 h-3.5 text-slate-600 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div id="unavailableContainer" class="mt-2 space-y-1.5 px-1"></div>
            <p id="unavailableEmptyMsg" class="text-xs text-slate-600 italic mt-1.5 px-1">Everyone is available for all shifts by default.</p>
          </details>

          <!-- Banned -->
          <details class="group mt-1">
            <summary class="flex items-center justify-between cursor-pointer text-xs font-medium text-slate-500 uppercase tracking-wider py-2 px-1 rounded-lg hover:bg-slate-700/20 transition-colors">
              <span>Banned Stations</span>
              <span class="flex items-center gap-2">
                <button onclick="event.stopPropagation(); addBanned()" class="text-indigo-400 hover:text-indigo-300 font-normal normal-case text-xs px-2 py-0.5 rounded hover:bg-indigo-500/10 transition-colors">+ Add</button>
                <svg class="w-3.5 h-3.5 text-slate-600 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div id="bannedContainer" class="mt-2 space-y-1.5 px-1"></div>
            <p id="bannedEmptyMsg" class="text-xs text-slate-600 italic mt-1.5 px-1">No station bans set.</p>
          </details>

          <!-- Avoid -->
          <details class="group mt-1">
            <summary class="flex items-center justify-between cursor-pointer text-xs font-medium text-slate-500 uppercase tracking-wider py-2 px-1 rounded-lg hover:bg-slate-700/20 transition-colors">
              <span>Avoid Pairing</span>
              <span class="flex items-center gap-2">
                <button onclick="event.stopPropagation(); addAvoidPair()" class="text-indigo-400 hover:text-indigo-300 font-normal normal-case text-xs px-2 py-0.5 rounded hover:bg-indigo-500/10 transition-colors">+ Add</button>
                <svg class="w-3.5 h-3.5 text-slate-600 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div id="avoidContainer" class="mt-2 space-y-1.5 px-1"></div>
            <p id="avoidEmptyMsg" class="text-xs text-slate-600 italic mt-1.5 px-1">No avoid rules set.</p>
          </details>

          <!-- Buddy -->
          <details class="group mt-1">
            <summary class="flex items-center justify-between cursor-pointer text-xs font-medium text-slate-500 uppercase tracking-wider py-2 px-1 rounded-lg hover:bg-slate-700/20 transition-colors">
              <span>Buddy System</span>
              <span class="flex items-center gap-2">
                <button onclick="event.stopPropagation(); addBuddy()" class="text-indigo-400 hover:text-indigo-300 font-normal normal-case text-xs px-2 py-0.5 rounded hover:bg-indigo-500/10 transition-colors">+ Add</button>
                <svg class="w-3.5 h-3.5 text-slate-600 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </span>
            </summary>
            <div class="mt-1 mb-2 px-1">
              <p class="text-[10px] text-slate-500/80">Engine picks 1-2 random day/shift combos per pair. Rotation takes priority.</p>
            </div>
            <div id="buddyContainer" class="space-y-1.5 px-1"></div>
            <p id="buddyEmptyMsg" class="text-xs text-slate-600 italic mt-1.5 px-1">No buddy pairs set.</p>
          </details>
        </div>

        <!-- Buttons -->
        <div class="flex flex-col sm:flex-row gap-3 fade-in" style="animation-delay:0.15s">
          <button onclick="loadDemoData()" class="flex-1 px-5 py-3 text-sm font-medium rounded-xl border border-slate-600/50 text-slate-300 hover:bg-slate-700/50 hover:text-white hover:border-slate-500/50 transition-all duration-200 scale-hover focus:ring-2 focus:ring-indigo-500/30 focus:outline-none">
            <span class="flex items-center justify-center gap-2">
              <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
              Load Demo Data
            </span>
          </button>
          <button onclick="handleGenerate()" id="generateBtn" class="flex-1 px-5 py-3 text-sm font-semibold rounded-xl bg-gradient-to-r from-indigo-500 to-indigo-600 text-white hover:from-indigo-400 hover:to-indigo-500 transition-all duration-200 scale-hover glow-indigo focus:ring-2 focus:ring-indigo-500/40 focus:outline-none disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100">
            <span id="generateBtnText" class="flex items-center justify-center gap-2">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              Generate Roster
            </span>
          </button>
        </div>

        <!-- Clear Saved Data -->
        <div class="flex justify-center fade-in pt-2">
          <button onclick="clearSavedData()" class="text-xs text-slate-500 hover:text-slate-300 transition-colors duration-200 px-3 py-1.5 rounded-lg hover:bg-slate-700/30">
            <span class="flex items-center gap-1.5">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
              Clear Saved Data
            </span>
          </button>
        </div>
      </section>

      <!-- ===== RIGHT — RESULTS ===== -->
      <section class="xl:col-span-8 space-y-4">

        <!-- Roster -->
        <div class="glass-strong rounded-2xl overflow-hidden fade-in" style="animation-delay:0.08s">
          <div class="px-5 py-4 border-b border-slate-700/40 flex items-center justify-between">
            <h2 class="text-sm font-semibold text-slate-200 heading flex items-center gap-2">
              <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              Weekly Roster
            </h2>
            <div id="rosterMeta" class="text-xs text-slate-500"></div>
          </div>
          <div id="rosterContainer" class="p-5 overflow-x-auto">
            <div class="flex flex-col items-center justify-center py-20 text-center">
              <div class="w-14 h-14 rounded-2xl bg-slate-800/80 border border-slate-700/50 flex items-center justify-center mb-4">
                <svg class="w-7 h-7 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              </div>
              <p class="text-sm font-medium text-slate-400">No roster yet</p>
              <p class="text-xs text-slate-600 mt-1 max-w-xs">Add prefects and station capacities, then click Generate.</p>
            </div>
          </div>
        </div>

        <!-- Workload Stats -->
        <div id="statsContainer" class="hidden glass rounded-2xl p-5 fade-in">
          <h3 class="text-sm font-semibold text-slate-200 heading mb-3 flex items-center gap-2">
            <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            Workload Distribution
          </h3>
          <div id="statsBars" class="space-y-2"></div>
        </div>

        <!-- Alerts -->
        <div id="alertsContainer" class="hidden space-y-2"></div>

        <!-- Substitute Finder -->
        <div id="substituteFinder" class="glass rounded-2xl p-5 fade-in" style="animation-delay:0.12s">
          <h3 class="text-sm font-semibold text-slate-200 heading mb-4 flex items-center gap-2">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            Substitute Finder
          </h3>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-4">
            <div>
              <label class="text-[10px] font-medium text-slate-500 uppercase tracking-wider mb-1.5 block">Shift</label>
              <select id="subShift" class="w-full bg-slate-800/80 border border-slate-700/60 rounded-xl px-3 py-2.5 text-sm text-slate-200 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200">
                <option value="Break">Break</option>
                <option value="Lunch">Lunch</option>
              </select>
            </div>
            <div>
              <label class="text-[10px] font-medium text-slate-500 uppercase tracking-wider mb-1.5 block">Day</label>
              <select id="subDay" class="w-full bg-slate-800/80 border border-slate-700/60 rounded-xl px-3 py-2.5 text-sm text-slate-200 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200">
                <option>Monday</option><option>Tuesday</option><option>Wednesday</option><option>Thursday</option><option>Friday</option>
              </select>
            </div>
            <div>
              <label class="text-[10px] font-medium text-slate-500 uppercase tracking-wider mb-1.5 block">Station</label>
              <select id="subStation" class="w-full bg-slate-800/80 border border-slate-700/60 rounded-xl px-3 py-2.5 text-sm text-slate-200 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200"><option value="">—</option></select>
            </div>
            <div>
              <label class="text-[10px] font-medium text-slate-500 uppercase tracking-wider mb-1.5 block">Absent</label>
              <select id="subPrefect" class="w-full bg-slate-800/80 border border-slate-700/60 rounded-xl px-3 py-2.5 text-sm text-slate-200 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200"><option value="">—</option></select>
            </div>
          </div>
          <button onclick="handleFindSubstitute()" class="px-5 py-2.5 text-sm font-medium rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 text-white hover:from-amber-400 hover:to-amber-500 transition-all duration-200 scale-hover focus:ring-2 focus:ring-amber-500/40 focus:outline-none">
            Find Substitute
          </button>
          <div id="subResults" class="pt-3"></div>
        </div>

        <!-- Fairness & Rotation Summary -->
        <div id="fairnessContainer" class="hidden glass rounded-2xl p-5 fade-in" style="animation-delay:0.1s">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-semibold text-slate-200 heading flex items-center gap-2">
              <svg class="w-4 h-4 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/></svg>
              Fairness & Rotation Summary
            </h3>
            <div id="fairnessBadge"></div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full fair-table text-xs">
              <thead>
                <tr class="bg-slate-800/60">
                  <th class="px-3 py-2.5 text-left font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-700/60">Prefect</th>
                  <th class="px-3 py-2.5 text-center font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-700/60">Break</th>
                  <th class="px-3 py-2.5 text-center font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-700/60">Lunch</th>
                  <th class="px-3 py-2.5 text-center font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-700/60">Total</th>
                  <th class="px-3 py-2.5 text-center font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-700/60">High-Traffic</th>
                  <th class="px-3 py-2.5 text-center font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-700/60">Low-Traffic</th>
                  <th class="px-3 py-2.5 text-center font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-700/60">Balance</th>
                </tr>
              </thead>
              <tbody id="fairnessBody"></tbody>
            </table>
          </div>
          <div id="fairnessLegend" class="mt-3 flex flex-wrap gap-3 text-[10px] text-slate-500"></div>
        </div>

      </section>
    </div>
  </main>

  <footer class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-6 text-center">
    <p class="text-xs text-slate-700/80">Duty Roster &mdash; <span class="text-emerald-400/60">Break</span> + <span class="text-cyan-400/60">Lunch</span> dual-shift capacity model</p>
  </footer>

  <script>
    // ================================================================
    //  STATE
    // ================================================================
    const DAYS = ['Monday','Tuesday','Wednesday','Thursday','Friday'];
    const SHIFTS = ['Break','Lunch'];

    let stations = [];       // { name, breakCap, lunchCap }
    let unavailable = [];    // { prefect, day, shift }
    let banned = [];         // { prefect, station }
    let avoidPairs = [];     // { a, b }
    let buddies = [];        // { a, b }

    let cachedRoster = null;
    let cachedStats = null;

    const DOT_COLORS = ['bg-indigo-400','bg-emerald-400','bg-amber-400','bg-rose-400','bg-cyan-400','bg-violet-400','bg-orange-400','bg-teal-400','bg-pink-400','bg-lime-400'];
    const colorMap = {};

    const DEMO = {
      prefects: ['John Smith','Sarah Johnson','Michael Chen','Lisa Park','Tom Anderson','Emily Zhang','David Wilson','Rachel Kim'],
      stations: [
        { name:'Canteen', breakCap:3, lunchCap:2 },
        { name:'Library', breakCap:2, lunchCap:3 },
        { name:'Main Gate', breakCap:3, lunchCap:3 }
      ],
      unavailable: [{ prefect:'John Smith', day:'Wednesday', shift:'Break' }],
      banned: [{ prefect:'David Wilson', station:'Library' }],
      avoid: [{ a:'Tom Anderson', b:'Emily Zhang' }],
      buddy: [{ a:'Michael Chen', b:'Lisa Park' }]
    };

    // ================================================================
    //  HELPERS
    // ================================================================
    function getPrefectNames() {
      return document.getElementById('prefectsInput').value.split('\n').map(s=>s.trim()).filter(Boolean);
    }
    function getStationNames() {
      return stations.map(s=>s.name).filter(Boolean);
    }
    function escHtml(s) {
      return (typeof s==='string'?s:'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
    function shuffleArray(arr) {
      for(let i=arr.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[arr[i],arr[j]]=[arr[j],arr[i]]}
      return arr;
    }
    function getPrefectColor(name) {
      if(!colorMap[name]) colorMap[name]=DOT_COLORS[Object.keys(colorMap).length%DOT_COLORS.length];
      return colorMap[name];
    }

    // ================================================================
    //  LOCALSTORAGE PERSISTENCE
    // ================================================================
    const STORAGE_KEY = 'dutyRosterState';

    function saveState() {
      const state = {
        prefects: document.getElementById('prefectsInput').value,
        stations: stations,
        unavailable: unavailable,
        banned: banned,
        avoidPairs: avoidPairs,
        buddies: buddies
      };
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch(e) { /* localStorage full or unavailable */ }
    }

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return false;
        const state = JSON.parse(raw);
        if (!state) return false;

        document.getElementById('prefectsInput').value = state.prefects || '';
        document.getElementById('stationsContainer').innerHTML = '';
        stations = [];
        (state.stations || []).forEach(s => addStation({name:s.name, breakCap:s.breakCap, lunchCap:s.lunchCap}));

        ['unavailableContainer','bannedContainer','avoidContainer','buddyContainer'].forEach(id=>document.getElementById(id).innerHTML='');
        unavailable=[]; banned=[]; avoidPairs=[]; buddies=[];
        (state.unavailable || []).forEach(u => addUnavailable(u));
        (state.banned || []).forEach(b => addBanned(b));
        (state.avoidPairs || []).forEach(a => addAvoidPair(a));
        (state.buddies || []).forEach(b => addBuddy(b));
        updateConstraintEmpties(); populateSubFinderDropdowns();
        return true;
      } catch(e) { return false; }
    }

    function clearSavedData() {
      if (!confirm('Clear all saved data and start fresh?')) return;
      localStorage.removeItem(STORAGE_KEY);

      document.getElementById('prefectsInput').value = '';
      document.getElementById('stationsContainer').innerHTML = '';
      stations = [];
      ['unavailableContainer','bannedContainer','avoidContainer','buddyContainer'].forEach(id=>document.getElementById(id).innerHTML='');
      unavailable=[]; banned=[]; avoidPairs=[]; buddies=[];
      updateConstraintEmpties(); populateSubFinderDropdowns();
      updateStationValidation();

      cachedRoster=null; cachedStats=null;
      document.getElementById('rosterContainer').innerHTML =
        '<div class="flex flex-col items-center justify-center py-20 text-center">'+
        '<div class="w-14 h-14 rounded-2xl bg-slate-800/80 border border-slate-700/50 flex items-center justify-center mb-4">'+
        '<svg class="w-7 h-7 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg></div>'+
        '<p class="text-sm font-medium text-slate-400">Data cleared</p>'+
        '<p class="text-xs text-slate-600 mt-1">Start by adding prefect names and stations.</p></div>';
      document.getElementById('statsContainer').classList.add('hidden');
      document.getElementById('fairnessContainer').classList.add('hidden');
      document.getElementById('alertsContainer').innerHTML='';
      document.getElementById('alertsContainer').classList.add('hidden');
      document.getElementById('rosterMeta').textContent='';
    }

    function autoSave() { saveState(); }

    // ================================================================
    //  STATION FORM
    // ================================================================
    function addStation(data) {
      const d = data||{name:'',breakCap:1,lunchCap:1};
      stations.push(d);
      renderAllStations();
      autoSave();
    }

    function removeStation(idx) {
      stations.splice(idx,1);
      autoSave();
      renderAllStations();
    }

    function renderAllStations() {
      const container = document.getElementById('stationsContainer');
      container.innerHTML = '';
      stations.forEach((d,i)=>{
        const div = document.createElement('div');
        div.id='stationRow-'+i;
        div.className='grid grid-cols-12 gap-1.5 items-center fade-in';
        div.style.animationDelay=(i*0.03)+'s';
        div.innerHTML = `
          <div class="col-span-5"><input type="text" placeholder="Station name" value="${escHtml(d.name)}"
            oninput="stations[${i}].name=this.value; refreshAllDropdowns()"
            class="w-full bg-slate-800/80 border border-slate-700/60 rounded-lg px-2.5 py-1.5 text-xs text-slate-200 placeholder:text-slate-500 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200"></div>
          <div class="col-span-3"><input type="number" min="1" max="99" value="${d.breakCap}"
            oninput="stations[${i}].breakCap=Math.max(1,parseInt(this.value)||1); updateStationValidation()"
            class="w-full bg-slate-800/80 border border-slate-700/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 text-center focus:ring-2 focus:ring-emerald-500/30 focus:border-emerald-500/40 outline-none transition-all duration-200"></div>
          <div class="col-span-3"><input type="number" min="1" max="99" value="${d.lunchCap}"
            oninput="stations[${i}].lunchCap=Math.max(1,parseInt(this.value)||1); updateStationValidation()"
            class="w-full bg-slate-800/80 border border-slate-700/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 text-center focus:ring-2 focus:ring-cyan-500/30 focus:border-cyan-500/40 outline-none transition-all duration-200"></div>
          <div class="col-span-1"><button onclick="removeStation(${i})" class="p-1.5 text-slate-500 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-all duration-200" title="Remove">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button></div>`;
        container.appendChild(div);
      });
      updateStationValidation();
      autoSave();
    }

    function updateStationValidation() {
      const N = getPrefectNames().length;
      const bTotal = stations.reduce((s,st)=>s+Math.max(1,parseInt(st.breakCap)||1),0);
      const lTotal = stations.reduce((s,st)=>s+Math.max(1,parseInt(st.lunchCap)||1),0);
      const bOk = N===0||bTotal===N;
      const lOk = N===0||lTotal===N;
      const el = document.getElementById('stationValidation');
      if(stations.length===0){el.innerHTML='';return;}
      el.innerHTML = `
        <div class="${N>0&&!bOk?'text-amber-400 font-medium':'text-slate-500'} flex items-center gap-1.5">
          <span class="inline-block w-2 h-2 rounded-full ${bOk?'bg-emerald-500/60':'bg-amber-500/60'}"></span>
          Break: <strong>${bTotal}</strong> / <strong>${N}</strong> prefects ${N>0?(bOk?'✓':'needs adjustment'):''}
        </div>
        <div class="${N>0&&!lOk?'text-amber-400 font-medium':'text-slate-500'} flex items-center gap-1.5">
          <span class="inline-block w-2 h-2 rounded-full ${lOk?'bg-cyan-500/60':'bg-amber-500/60'}"></span>
          Lunch: <strong>${lTotal}</strong> / <strong>${N}</strong> prefects ${N>0?(lOk?'✓':'needs adjustment'):''}
        </div>`;
    }

    // ================================================================
    //  CONSTRAINT FORMS
    // ================================================================
    function reindexRows(containerId, array, idPrefix, renderFn) {
      const c = document.getElementById(containerId); if(!c) return;
      c.innerHTML=''; array.forEach((d,i)=>renderFn(i,d));
    }

    const constraintMeta = {
      unavailable: { container:'unavailableContainer', renderer:null },
      banned: { container:'bannedContainer', renderer:null },
      avoidPairs: { container:'avoidContainer', renderer:null },
      buddies: { container:'buddyContainer', renderer:null }
    };

    function addRemoveBtn(arrName, idx) {
      return '<button onclick="removeConstraint(\''+arrName+'\','+idx+')" class="p-1 text-slate-500 hover:text-red-400 hover:bg-red-500/10 rounded-lg transition-all duration-200 shrink-0"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>';
    }

    // ---- Unavailable ----
    function addUnavailable(data) {
      const d = data||{prefect:'',day:'Monday',shift:'Break'};
      unavailable.push(d);
      renderUnavailableRow(unavailable.length-1,d);
      updateConstraintEmpties(); autoSave();
    }
    function renderUnavailableRow(idx, d) {
      const c=document.getElementById('unavailableContainer');
      if(!c) return;
      const pn=getPrefectNames();
      const div=document.createElement('div'); div.className='flex items-center gap-1.5 fade-in';
      div.innerHTML='<select onchange="unavailable['+idx+'].prefect=this.value" class="flex-1 min-w-0 bg-slate-800/80 border border-slate-700/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200"><option value="">— Prefect —</option>'+pn.map(p=>'<option value="'+escHtml(p)+'"'+(p===d.prefect?' selected':'')+'>'+escHtml(p)+'</option>').join('')+'</select>'+
        '<span class="text-xs text-slate-500">misses</span>'+
        '<select onchange="unavailable['+idx+'].day=this.value" class="w-24 bg-slate-800/80 border border-slate-700/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200">'+DAYS.map(dy=>'<option value="'+dy+'"'+(dy===d.day?' selected':'')+'>'+dy.slice(0,3)+'</option>').join('')+'</select>'+
        '<select onchange="unavailable['+idx+'].shift=this.value" class="w-20 bg-slate-800/80 border border-slate-700/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200">'+SHIFTS.map(s=>'<option value="'+s+'"'+(s===d.shift?' selected':'')+'>'+s+'</option>').join('')+'</select>'+
        addRemoveBtn('unavailable',idx);
      c.appendChild(div);
    }
    constraintMeta.unavailable.renderer = renderUnavailableRow;

    // ---- Banned ----
    function addBanned(data) {
      const d = data||{prefect:'',station:''};
      banned.push(d);
      renderBannedRow(banned.length-1,d);
      updateConstraintEmpties(); autoSave();
    }
    function renderBannedRow(idx, d) {
      const c=document.getElementById('bannedContainer'); if(!c) return;
      const pn=getPrefectNames(); const sn=getStationNames();
      const div=document.createElement('div'); div.className='flex items-center gap-1.5 fade-in';
      div.innerHTML='<select onchange="banned['+idx+'].prefect=this.value" class="flex-1 min-w-0 bg-slate-800/80 border border-slate-700/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200"><option value="">— Prefect —</option>'+pn.map(p=>'<option value="'+escHtml(p)+'"'+(p===d.prefect?' selected':'')+'>'+escHtml(p)+'</option>').join('')+'</select>'+
        '<span class="text-xs text-slate-500">cannot go to</span>'+
        '<select onchange="banned['+idx+'].station=this.value" class="flex-[1.5] min-w-0 bg-slate-800/80 border border-slate-700/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200"><option value="">— Station —</option>'+sn.map(s=>'<option value="'+escHtml(s)+'"'+(s===d.station?' selected':'')+'>'+escHtml(s)+'</option>').join('')+'</select>'+
        addRemoveBtn('banned',idx);
      c.appendChild(div);
    }
    constraintMeta.banned.renderer = renderBannedRow;

    // ---- Avoid ----
    function addAvoidPair(data) {
      const d = data||{a:'',b:''};
      avoidPairs.push(d);
      renderAvoidRow(avoidPairs.length-1,d);
      updateConstraintEmpties(); autoSave();
    }
    function renderAvoidRow(idx, d) {
      const c=document.getElementById('avoidContainer'); if(!c) return;
      const pn=getPrefectNames();
      const div=document.createElement('div'); div.className='flex items-center gap-1.5 fade-in';
      div.innerHTML='<select onchange="avoidPairs['+idx+'].a=this.value" class="flex-1 min-w-0 bg-slate-800/80 border border-slate-700/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200"><option value="">— Prefect —</option>'+pn.map(p=>'<option value="'+escHtml(p)+'"'+(p===d.a?' selected':'')+'>'+escHtml(p)+'</option>').join('')+'</select>'+
        '<span class="text-xs text-slate-500">&amp;</span>'+
        '<select onchange="avoidPairs['+idx+'].b=this.value" class="flex-1 min-w-0 bg-slate-800/80 border border-slate-700/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200"><option value="">— Prefect —</option>'+pn.map(p=>'<option value="'+escHtml(p)+'"'+(p===d.b?' selected':'')+'>'+escHtml(p)+'</option>').join('')+'</select>'+
        '<span class="text-xs text-slate-500">avoid</span>'+addRemoveBtn('avoidPairs',idx);
      c.appendChild(div);
    }
    constraintMeta.avoidPairs.renderer = renderAvoidRow;

    // ---- Buddy ----
    function addBuddy(data) {
      const d = data||{a:'',b:''};
      buddies.push(d);
      renderBuddyRow(buddies.length-1,d);
      updateConstraintEmpties(); autoSave();
    }
    function renderBuddyRow(idx, d) {
      const c=document.getElementById('buddyContainer'); if(!c) return;
      const pn=getPrefectNames();
      const div=document.createElement('div'); div.className='flex items-center gap-1.5 fade-in';
      div.innerHTML='<select onchange="buddies['+idx+'].a=this.value" class="flex-1 min-w-0 bg-slate-800/80 border border-slate-700/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200"><option value="">— Prefect —</option>'+pn.map(p=>'<option value="'+escHtml(p)+'"'+(p===d.a?' selected':'')+'>'+escHtml(p)+'</option>').join('')+'</select>'+
        '<span class="text-xs text-slate-500">&amp;</span>'+
        '<select onchange="buddies['+idx+'].b=this.value" class="flex-1 min-w-0 bg-slate-800/80 border border-slate-700/60 rounded-lg px-2 py-1.5 text-xs text-slate-200 focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500/60 outline-none transition-all duration-200"><option value="">— Prefect —</option>'+pn.map(p=>'<option value="'+escHtml(p)+'"'+(p===d.b?' selected':'')+'>'+escHtml(p)+'</option>').join('')+'</select>'+
        '<span class="text-xs text-slate-500">together</span>'+addRemoveBtn('buddies',idx);
      c.appendChild(div);
    }
    constraintMeta.buddies.renderer = renderBuddyRow;

    // ---- Constraint helpers ----
    function removeConstraint(arrName, idx) {
      const meta = constraintMeta[arrName];
      const arr = window[arrName];
      arr.splice(idx,1);
      reindexRows(meta.container, arr, '', meta.renderer);
      updateConstraintEmpties(); autoSave();
    }
    function updateConstraintEmpties() {
      document.getElementById('unavailableEmptyMsg').classList.toggle('hidden', unavailable.length>0);
      document.getElementById('bannedEmptyMsg').classList.toggle('hidden', banned.length>0);
      document.getElementById('avoidEmptyMsg').classList.toggle('hidden', avoidPairs.length>0);
      document.getElementById('buddyEmptyMsg').classList.toggle('hidden', buddies.length>0);
    }
    function refreshAllDropdowns() {
      Object.keys(constraintMeta).forEach(k=>{
        const m=constraintMeta[k]; reindexRows(m.container, window[k], '', m.renderer);
      });
      updateStationValidation();
      populateSubFinderDropdowns();
    }

    // ================================================================
    //  DEMO DATA
    // ================================================================
    function loadDemoData() {
      document.getElementById('prefectsInput').value = DEMO.prefects.join('\n');
      document.getElementById('stationsContainer').innerHTML = '';
      stations = [];
      DEMO.stations.forEach(s => addStation({name:s.name,breakCap:s.breakCap,lunchCap:s.lunchCap}));
      ['unavailableContainer','bannedContainer','avoidContainer','buddyContainer'].forEach(id=>document.getElementById(id).innerHTML='');
      unavailable=[]; banned=[]; avoidPairs=[]; buddies=[];
      DEMO.unavailable.forEach(u=>addUnavailable(u));
      DEMO.banned.forEach(b=>addBanned(b));
      DEMO.avoid.forEach(a=>addAvoidPair(a));
      DEMO.buddy.forEach(b=>addBuddy(b));
      updateConstraintEmpties(); populateSubFinderDropdowns();
      cachedRoster=null; cachedStats=null;
      document.getElementById('rosterContainer').innerHTML =
        '<div class="flex flex-col items-center justify-center py-20 text-center">'+
        '<div class="w-14 h-14 rounded-2xl bg-slate-800/80 border border-slate-700/50 flex items-center justify-center mb-4">'+
