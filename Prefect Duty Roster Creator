    // ================================================================
    //  FAIRNESS ANALYTICS
    // ================================================================
    function renderFairnessAnalytics(roster, stationNames, prefects) {
      const container = document.getElementById('fairnessContainer');
      container.classList.remove('hidden');

      const stationTraffic = {};
      stationNames.forEach((s,i)=>{
        const bc = stations[i] ? Math.max(1, parseInt(stations[i].breakCap)||1) : 1;
        const lc = stations[i] ? Math.max(1, parseInt(stations[i].lunchCap)||1) : 1;
        stationTraffic[s] = (bc + lc) * 5;
      });
      const trafficValues = Object.values(stationTraffic).sort((a,b)=>a-b);
      const median = trafficValues.length > 0 ? trafficValues[Math.floor(trafficValues.length/2)] : 0;
      const highTrafficStations = new Set(stationNames.filter(s => stationTraffic[s] > median));

      const stats = {};
      prefects.forEach(p => {
        stats[p] = { break: 0, lunch: 0, high: 0, low: 0, stations: {} };
      });

      DAYS.forEach(day => {
        SHIFTS.forEach(shift => {
          if (!roster[day] || !roster[day][shift]) return;
          stationNames.forEach(station => {
            const assigned = roster[day][shift][station] || [];
            assigned.forEach(p => {
              if (shift === 'Break') stats[p].break++;
              else stats[p].lunch++;
              if (highTrafficStations.has(station)) stats[p].high++;
              else stats[p].low++;
              if (!stats[p].stations[station]) stats[p].stations[station] = 0;
              stats[p].stations[station]++;
            });
          });
        });
      });

      const totals = prefects.map(p => (stats[p].break + stats[p].lunch));
      const maxTotal = Math.max(...totals);
      const minTotal = Math.min(...totals);
      const perfectlyBalanced = (maxTotal - minTotal) <= 1;
      const badgeEl = document.getElementById('fairnessBadge');
      if (perfectlyBalanced) {
        badgeEl.innerHTML = '<span class="badge-perfect inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-semibold"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>Perfectly Balanced</span>';
      } else {
        badgeEl.innerHTML = '<span class="badge-warning inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-[10px] font-semibold"><svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>Needs Attention</span>';
      }

      const legend = document.getElementById('fairnessLegend');
      legend.innerHTML = '';
      stationNames.forEach(s => {
        const isHigh = highTrafficStations.has(s);
        const tag = document.createElement('span');
        tag.className = 'inline-flex items-center gap-1';
        tag.innerHTML = '<span class="inline-block w-2 h-2 rounded-full '+(isHigh?'bg-rose-500/70':'bg-slate-500/50')+'"></span>'+escHtml(s)+' <span class="text-slate-600">('+(isHigh?'High':'Low')+')</span>';
        legend.appendChild(tag);
      });

      const body = document.getElementById('fairnessBody');
      body.innerHTML = '';
      const sorted = [...prefects].sort((a,b)=>{
        const ta = stats[a].break + stats[a].lunch;
        const tb = stats[b].break + stats[b].lunch;
        return tb - ta || a.localeCompare(b);
      });

      sorted.forEach(p => {
        const s = stats[p];
        const total = s.break + s.lunch;
        const diff = Math.abs(s.break - s.lunch);
        let balanceText, balanceClass;
        if (diff <= 1) { balanceText = 'Even'; balanceClass = 'text-emerald-400'; }
        else if (diff <= 2) { balanceText = 'Light'; balanceClass = 'text-amber-400'; }
        else { balanceText = 'Uneven'; balanceClass = 'text-rose-400'; }

        const tr = document.createElement('tr');
        tr.className = 'border-b border-slate-700/40 transition-colors duration-150';
        tr.innerHTML = '<td class="px-3 py-2.5 text-slate-200 font-medium">'+escHtml(p)+'</td>'+
          '<td class="px-3 py-2.5 text-center"><span class="text-emerald-400">'+s.break+'</span></td>'+
          '<td class="px-3 py-2.5 text-center"><span class="text-cyan-400">'+s.lunch+'</span></td>'+
          '<td class="px-3 py-2.5 text-center text-slate-300 font-medium">'+total+'</td>'+
          '<td class="px-3 py-2.5 text-center"><span class="'+(s.high > 0 ? 'text-rose-400' : 'text-slate-600')+'">'+s.high+'</span></td>'+
          '<td class="px-3 py-2.5 text-center"><span class="text-slate-400">'+s.low+'</span></td>'+
          '<td class="px-3 py-2.5 text-center"><span class="text-xs font-medium '+balanceClass+'">'+balanceText+'</span></td>';
        body.appendChild(tr);
      });
    }

