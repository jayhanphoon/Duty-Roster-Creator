    function handleFindSubstitute() {
      const shift=document.getElementById('subShift').value;
      const day=document.getElementById('subDay').value;
      const station=document.getElementById('subStation').value;
      const absent=document.getElementById('subPrefect').value;
      const r=document.getElementById('subResults');

      if(!shift||!day||!station||!absent){r.innerHTML='<div class="text-xs text-slate-500 italic p-2">Fill all fields.</div>';return;}
      if(!cachedRoster){r.innerHTML='<div class="text-xs text-amber-400/70 italic p-2">Generate a roster first.</div>';return;}

      const dd=cachedRoster[day];
      if(!dd||!dd[shift]){r.innerHTML='<div class="text-xs text-amber-400/70 italic p-2">No data for '+day+' '+shift+'.</div>';return;}

      const atTarget=dd[shift][station]||[];
      if(!atTarget.includes(absent)){r.innerHTML='<div class="text-xs text-amber-400/70 italic p-2">'+escHtml(absent)+' is not at '+escHtml(station)+' on '+day+' '+shift+'.</div>';return;}

      const sc=cachedStats?cachedStats.shiftCount:{};
      const subs = getPrefectNames().filter(p=>p!==absent).map(p=>{
        let cur=null;
        for(const[s,list]of Object.entries(dd[shift])) if(list.includes(p)){cur=s;break;}
        return {name:p,currentStation:cur,atOther:cur&&cur!==station,shifts:sc[p]||0};
      }).filter(s=>s.atOther).sort((a,b)=>a.shifts-b.shifts||a.name.localeCompare(b.name));

      if(subs.length===0){r.innerHTML='<div class="text-xs text-amber-400/70 p-3 rounded-xl bg-amber-500/8 border border-amber-500/20">No substitutes — all others are at this station too.</div>';return;}

      let h='<div class="text-xs font-medium text-slate-400 mb-3">Best subs for <strong class="text-slate-200">'+escHtml(station)+'</strong> ('+shift+') on <strong class="text-slate-200">'+day+'</strong> &mdash; absent: <span class="text-slate-300">'+escHtml(absent)+'</span></div>';
      subs.slice(0,5).forEach((s,i)=>{
        const bc=i===0?'bg-emerald-500/15 text-emerald-400 border-emerald-500/20':i===1?'bg-indigo-500/15 text-indigo-400 border-indigo-500/20':'bg-slate-700/50 text-slate-300 border-slate-600/40';
        const rl=i===0?'Best fit':i===1?'Good fit':'Available';
        h+='<div class="flex items-center justify-between px-4 py-3 rounded-xl border transition-all duration-200 hover:bg-slate-700/30 fade-in '+bc+'">'+
          '<div class="flex items-center gap-3">'+
          '<span class="flex items-center justify-center w-7 h-7 rounded-lg text-xs font-bold '+(i===0?'bg-emerald-500/20 text-emerald-400':i===1?'bg-indigo-500/20 text-indigo-400':'bg-slate-700 text-slate-400')+'">'+(i+1)+'</span>'+
          '<div><div class="text-sm font-medium text-slate-200">'+escHtml(s.name)+'</div>'+
          '<div class="text-xs text-slate-500">Currently at '+escHtml(s.currentStation)+' &middot; '+s.shifts+' shifts</div></div></div>'+
          '<span class="text-xs font-medium '+(i===0?'text-emerald-400':i===1?'text-indigo-400':'text-slate-500')+'">'+rl+'</span></div>';
      });
      if(subs.length>5) h+='<div class="text-xs text-slate-600 mt-2">+'+(subs.length-5)+' more available</div>';
      r.innerHTML=h;
    }

    // ================================================================
    //  INIT
    // ================================================================
    document.addEventListener('DOMContentLoaded',()=>{
      if (!loadState()) {
        addStation(); addStation();
      }
      updateStationValidation(); updateConstraintEmpties(); populateSubFinderDropdowns();
    });
  </script>
</body>
</html>
